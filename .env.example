# ───────── NEXO · variables de entorno ─────────
# Nada es obligatorio: sin variables, la app funciona 100 % en local (IndexedDB) y sin IA.
# Las variables NEXT_PUBLIC_* llegan al navegador; el resto SOLO existe en el servidor.

# ── Supabase (sincronización opcional + login con enlace mágico) ──
# 1) Crea un proyecto en supabase.com  2) Aplica supabase/migrations/*.sql (SQL editor o `supabase db push`)
# 3) Auth → Providers → Email: activa "magic link"; Auth → URL Configuration: añade https://TU-DOMINIO/ajustes
# 4) Uso personal: tras crear tu usuario, desactiva "Allow new users to sign up".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Asistente IA (servidor) ──
# Proveedor: anthropic (por defecto) u openai
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modelo de Claude (por defecto claude-opus-5-5); esfuerzo low|medium|high
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# Fallback de servidor ante rechazos (on por defecto con modelos compatibles): off para desactivarlo
AI_FALLBACKS=on
# Alternativa OpenAI (Responses API con store:false)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Límites (por instancia): peticiones/minuto, peticiones/día, tokens/día, tokens máx. por respuesta
AI_RATE_PER_MINUTE=12
AI_REQUESTS_PER_DAY=300
AI_DAILY_TOKEN_BUDGET=2000000
AI_MAX_OUTPUT_TOKENS=8000
# Emails autorizados a usar la IA (separados por comas). Requiere Supabase.
ALLOWED_EMAILS=
# SOLO para desarrollo local sin Supabase: permite la IA sin login (no lo actives en producción)
AI_ALLOW_ANONYMOUS=false

# ── Polar AccessLink (servidor) ──
# Crea un cliente en https://admin.polaraccesslink.com con redirect https://TU-DOMINIO/api/integrations/polar/callback
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
POLAR_REDIRECT_URI=
# Clave AES-256 para cifrar tokens (32 bytes en base64 o hex). Genera una con: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Alternativa a iniciar sesión para usar el asistente: código personal (≥ 12 caracteres, secreto).
# Se escribe una vez en la app (Asistente → paso 1) y se guarda solo en ese dispositivo.
AI_ACCESS_CODE=
